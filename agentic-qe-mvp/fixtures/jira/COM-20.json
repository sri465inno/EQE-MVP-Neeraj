          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Extend commission to group blocks and package rates, and raise the per-reservation cap for release 2.0."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Commission per reservation is capped at USD 750."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Group reservations of 10 or more rooms are commissioned at a flat 8%."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Package rates are commissioned on 70% of the package price."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
