# Devin engine for the EQE dashboard. Copy to .env, fill in, then restart with ./start-all.sh.
# Service-user API key (starts with cog_) whose role has UseDevinSessions. Never commit .env.
DEVIN_API_KEY=
# Organization ID from Settings > Devin API (starts with org-).
DEVIN_ORG_ID=
# API base URL: https://api.devin.ai, or your dedicated deployment's API (for example https://<tenant>.devinenterprise.com/api).
DEVIN_API_URL=https://api.devin.ai
# Optional: ACU cap per cycle session, organization knowledge IDs to attach (comma-separated), a playbook to attach.
DEVIN_MAX_ACU=
DEVIN_KNOWLEDGE_IDS=
DEVIN_PLAYBOOK_ID=
# Optional tuning: poll interval (seconds), per-stage timeout and idle nudge (minutes).
DEVIN_POLL_SECONDS=15
DEVIN_STAGE_TIMEOUT_MINUTES=90
DEVIN_NUDGE_MINUTES=12
